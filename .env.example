# Deployment used by `npx convex dev`
# Get these from your Convex dashboard after running `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-project-id # team: your-team, project: your-project
VITE_CONVEX_URL=https://your-project.convex.cloud
VITE_CONVEX_SITE_URL=https://your-project.convex.site

# Backend authentication (required for convex/auth.ts)
# CONVEX_SITE_URL is built in to every Convex deployment; do not set it.
# Set the app origin that serves this deployment's auth (sessions live on that origin):
# npx convex env set SITE_URL http://localhost:5173
# Extra trusted app origins, comma-separated (optional): npx convex env set APP_ORIGINS ...

# Your local dev server URL
VITE_SITE_URL=http://localhost:5173

# Required Convex environment variables (set via `npx convex env set`):
# Run: npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"

# Optional: GitHub OAuth (for social login, set via `npx convex env set`)
# Get these from https://github.com/settings/developers
# GITHUB_CLIENT_ID=your_github_oauth_app_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Google OAuth (server-side, set via `npx convex env set`)
# Get these from https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Email OTP (server-side, set via `npx convex env set`)
# Off by default so contributors get plain email signup with zero setup.
# AUTH_EMAIL_OTP_ENABLED=true

# Mailgun EU transactional email (server-side, set via `npx convex env set`)
# MAILGUN_API_KEY=your_mailgun_api_key
# MAILGUN_DOMAIN=mg.nextbite.kevinkraemer.com
# Without these, OTP sends fail closed and the login UI hides the OTP method, unless the
# explicit local fallback is set (local development only, never preview or production):
# MAILGUN_DEV_FALLBACK=true

# Google Maps API key (get from https://console.cloud.google.com/)
# Enable Maps JavaScript API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=
