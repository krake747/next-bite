{
    "name": "next-bite",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "convex:deploy": "convex deploy",
        "convex:dev": "convex dev",
        "dev": "vite",
        "fmt": "oxfmt  --no-error-on-unmatched-pattern",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "lint:ts": "tsc -b --noEmit",
        "netlify": "pnpx netlify",
        "postinstall": "lefthook install",
        "preview": "vite preview --port=5173",
        "sandcastle:build": "pnpm --filter @next-bite/sandcastle-tools sandcastle:build",
        "sandcastle:run": "pnpm --filter @next-bite/sandcastle-tools sandcastle:run",
        "skills:krake747": "pnx skills add krake747/skills",
        "skills:mattpocock": "pnx skills add mattpocock/skills",
        "test": "vitest run",
        "test:all": "pnpm test && pnpm test:e2e",
        "test:e2e": "playwright test",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@convex-dev/better-auth": "^0.12.6",
        "@fontsource-variable/fraunces": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@formisch/react": "1.1.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.105.0",
        "@tanstack/react-router": "^1.170.46",
        "@vis.gl/react-google-maps": "^1.10.1",
        "better-auth": "~1.7.14",
        "convex": "^1.48.0",
        "cva": "1.0.0-beta.8",
        "immer": "^11.2.9",
        "lucide-react": "^1.64.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "valibot": "^1.5.0",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tanstack/router-plugin": "^1.168.48",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/google.maps": "^3.66.9",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "fallow": "^3.37.0",
        "jsdom": "^29.1.1",
        "lefthook": "^2.2.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "tsx": "^4.23.15",
        "typescript": "~7.0.2",
        "vite": "8.3.5",
        "vitest": "^4.1.10"
    },
    "browserslist": {
        "production": [
            "last 2 Chrome versions",
            "last 2 ChromeAndroid versions",
            "last 2 Edge versions",
            "last 2 Firefox versions",
            "last 2 FirefoxAndroid versions",
            "last 2 Safari versions",
            "last 2 iOS versions",
            "not IE 11",
            "not dead"
        ],
        "development": [
            "last 1 Chrome version",
            "last 1 ChromeAndroid version",
            "last 1 Edge version",
            "last 1 Firefox version",
            "last 1 FirefoxAndroid version",
            "last 1 Safari version",
            "last 1 iOS version"
        ]
    },
    "packageManager": "pnpm@11.14.0"
}
