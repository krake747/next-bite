{
    "name": "next-bite",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "check": "pnpm fmt:check && pnpm lint && pnpm lint:ts && pnpm test",
        "check:arch": "pnpm fallow audit",
        "check:full": "pnpm check && pnpm check:arch && pnpm build",
        "convex:deploy": "convex deploy",
        "convex:dev": "convex dev",
        "deploy": "cf deploy",
        "dev": "vp dev",
        "doctor": "react-doctor",
        "fmt": "vp fmt --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check",
        "lint": "vp lint",
        "lint:fix": "vp lint --fix",
        "lint:ts": "tsc -b --noEmit",
        "postinstall": "lefthook install",
        "preview": "vite preview --port=5173",
        "skills:krake747": "pnx skills add krake747/skills",
        "skills:mattpocock": "pnx skills add mattpocock/skills",
        "test": "vitest run",
        "test:browser": "vitest run --project browser",
        "test:e2e": "playwright test",
        "test:integration": "vitest run --project integration",
        "test:pure": "vitest run --project pure",
        "test:unit": "vitest run --project unit",
        "test:watch": "vitest"
    },
