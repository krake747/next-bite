{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
    "workspaces": {
        "patterns": ["."]
    },
    "duplicates": {
        "minOccurrences": 3
    },
    "rules": {
        "unused-dependencies": "warn",
        "unused-export": "warn",
        "unused-file": "warn",
        "boundary-violation": "error"
    },
    "ignoreDependencies": ["@fontsource-variable/*", "@types/google.maps"],
    "ignoreFindings": ["cloudflare.config.ts"],
    "boundaries": {
        "zones": [
            { "name": "core", "patterns": ["src/core/**"] },
            { "name": "ui", "patterns": ["src/ui/**"] },
            { "name": "pattern", "patterns": ["src/pattern/**"] },
            { "name": "features", "patterns": ["src/features/*.ts", "src/features/*.tsx"] },
            { "name": "features-restaurants", "patterns": ["src/features/restaurants/**"] },
            { "name": "features-wheel", "patterns": ["src/features/wheel/**"] },
            { "name": "routes", "patterns": ["src/routes/**"] },
            { "name": "convex", "patterns": ["convex/**"] }
        ],
        "rules": [
            { "from": "core", "allow": ["core", "convex", "ui"] },
            { "from": "ui", "allow": ["core", "ui"] },
            { "from": "pattern", "allow": ["core", "ui", "pattern", "convex"] },
            { "from": "features", "allow": ["core", "ui", "pattern", "features", "convex"] },
            { "from": "features-restaurants", "allow": ["core", "ui", "pattern", "features", "convex"] },
            { "from": "features-wheel", "allow": ["core", "ui", "pattern", "features", "convex"] },
            {
                "from": "routes",
                "allow": [
                    "core",
                    "ui",
                    "pattern",
                    "features",
                    "features-restaurants",
                    "features-wheel",
                    "convex",
                    "routes"
                ]
            },
            { "from": "convex", "allow": ["convex", "core"] }
        ]
    }
}
