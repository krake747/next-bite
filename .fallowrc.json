{
    "$schema": "./node_modules/fallow/schema.json",
    "workspaces": {
        "patterns": ["."]
    },
    "duplicates": {
        "minOccurrences": 3
    },
    "rules": {
        "unused-dependencies": "warn",
        "unused-export": "warn",
        "unused-file": "warn",
        "boundary-violation": "error"
    },
    "audit": {
        "deadCodeBaseline": "fallow/baseline.dead-code.json",
        "healthBaseline": "fallow/baseline.health.json"
    },
    "ignoreExports": [{ "file": "src/core/hooks.ts", "exports": ["useAuth"] }],
    "ignoreFindings": ["cloudflare.config.ts", "doctor.config.ts"],
    "boundaries": {
        "zones": [
            { "name": "core", "patterns": ["src/core/**"] },
            { "name": "api", "patterns": ["src/api/**"] },
            { "name": "ui", "patterns": ["src/ui/**"] },
            { "name": "pattern", "patterns": ["src/pattern/**"] },
            { "name": "features", "patterns": ["src/features/**"] },
            { "name": "routes", "patterns": ["src/routes/**"] },
            { "name": "convex", "patterns": ["convex/**"] }
        ],
        "rules": [
            { "from": "core", "allow": ["core", "api", "convex"] },
            { "from": "api", "allow": ["api", "convex", "core"] },
            { "from": "ui", "allow": ["ui"] },
            { "from": "pattern", "allow": ["core", "ui", "pattern", "api"], "allowTypeOnly": ["convex"] },
            { "from": "features", "allow": ["core", "ui", "pattern", "api"], "allowTypeOnly": ["convex"] },
            {
                "from": "routes",
                "allow": ["core", "ui", "pattern", "features", "api", "convex", "routes"]
            },
            { "from": "convex", "allow": ["convex", "core"] }
        ]
    }
}
